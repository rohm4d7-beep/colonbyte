{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "francis-plumbing-chatbot",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "account_id": "523261c4ccc00440a1bcc3cf8e8165c1",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "francis-plumbing-leads",
      "database_id": "2f995f31-ac3c-4085-8d28-34c162f581d0",
      "migrations_dir": "migrations"
    }
  ]
}
