PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/leadforge
CLIENT_ORIGIN=http://localhost:3002
# Absolute, publicly-reachable base URL for this server — outreach emails link to
# ${PUBLIC_BASE_URL}/demo/:id, and a relative path would be meaningless outside a browser.
PUBLIC_BASE_URL=http://localhost:5000
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Free API key from pexels.com/api — used to pull a curated, category-appropriate stock
# photo for each demo site's hero image instead of relying on whatever random photo Google
# Maps happens to have. Demo generation still works without it, just falls back to the
# scraped Maps photo.
PEXELS_API_KEY=
SENDGRID_API_KEY=
# Must be a Single Sender you've verified in SendGrid (Settings > Sender Authentication >
# Verify a Single Sender) — no domain purchase/DNS needed, just click the confirmation
# link SendGrid emails to this address.
SENDGRID_FROM_EMAIL=
# Base64 DER public key from SendGrid's Event Webhook settings (with signing enabled) —
# used to verify tracking events (open/click/bounce) actually came from SendGrid.
SENDGRID_WEBHOOK_PUBLIC_KEY=
