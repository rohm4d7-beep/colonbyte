PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/leadforge
CLIENT_ORIGIN=http://localhost:3002
# Absolute, publicly-reachable base URL for this server — outreach emails link to
# ${PUBLIC_BASE_URL}/demo/:id, and a relative path would be meaningless outside a browser.
PUBLIC_BASE_URL=http://localhost:5000
GROQ_API_KEY=
# Optional — GROQ_API_KEY_2, _3, _4, etc., each from a SEPARATE Groq account (not another key
# from the same account, which would share the same daily quota and provide no extra headroom).
# services/groqClient.js automatically fails over through them in order once the previous key's
# daily token budget is exhausted, multiplying the pipeline's usable daily Groq capacity by
# however many accounts are configured. Add a 5th, 6th, etc. later just by setting
# GROQ_API_KEY_5, GROQ_API_KEY_6 — groqClient.js picks up any consecutively-numbered key with no
# code change.
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_MODEL=openai/gpt-oss-20b
# Free API key from pexels.com/api — used to pull a curated, category-appropriate stock
# photo for each demo site's hero image instead of relying on whatever random photo Google
# Maps happens to have. Demo generation still works without it, just falls back to the
# scraped Maps photo.
PEXELS_API_KEY=
BREVO_API_KEY=
# Must be a Sender you've verified in Brevo (Senders, Domains & Dedicated IPs > Senders >
# Add a Sender) — no domain purchase/DNS needed, just confirm the 6-digit code Brevo
# emails to this address.
BREVO_FROM_EMAIL=
# Shared secret you choose yourself and append to the webhook URL you configure in Brevo
# (Settings > Webhooks): https://<PUBLIC_BASE_URL>/webhooks/brevo?token=<this value>.
# Brevo doesn't sign webhook requests, so this token is what verifies a tracking event
# (open/click/bounce) actually came from Brevo and not an arbitrary POST.
BREVO_WEBHOOK_SECRET=
