PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/devsaura-leads
CLIENT_ORIGIN=http://localhost:3000
# Absolute, publicly-reachable base URL for this server — outreach emails link to
# ${PUBLIC_BASE_URL}/demo/:id, and a relative path would be meaningless outside a browser.
PUBLIC_BASE_URL=http://localhost:5000
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
RESEND_API_KEY=
# Sandbox sender that works without a verified domain — Resend will only actually
# deliver mail sent from this address to your own Resend account email until you
# verify a domain and switch this to something like outreach@yourdomain.com.
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_WEBHOOK_SECRET=
